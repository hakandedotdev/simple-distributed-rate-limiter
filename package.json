{
  "name": "simple-distributed-rate-limiter",
  "version": "0.1.0",
  "description": "Simple provider agnostic distributed rate limiter in TypeScript.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --watch examples/basic.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsup",
    "postbuild": "node -e \"require('fs').cpSync('src/stores/lua','dist/lua',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "start:redis": "docker compose up -d redis",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
